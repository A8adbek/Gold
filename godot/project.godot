; Red Dune Valley native 3D prototype
; This project is intentionally separate from the current WebView APK.
config_version=5

[application]
config/name="Red Dune Valley 3D"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=360
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[input]
roll_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
roll_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
pitch_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
pitch_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
